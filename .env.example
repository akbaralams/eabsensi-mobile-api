# Salin ke .env (di-gitignore). Semua konfigurasi hanya dari environment; .env hanya kemudahan lokal.

# --- Server ---
LISTEN_ADDR=127.0.0.1:8080
# Batas request yang diproses bersamaan per instance (sisanya antre sampai REQUEST_TIMEOUT_SECS).
MAX_CONCURRENT_REQUESTS=2048
# Cukup panjang untuk unggah foto 4 MB di jaringan seluler lambat.
REQUEST_TIMEOUT_SECS=60
# json (produksi) atau pretty (lokal). Level lewat RUST_LOG, mis. info,sqlx=warn
LOG_FORMAT=json
RUST_LOG=info,sqlx=warn
# Proxy tepercaya (IP/CIDR, koma). X-Forwarded-For/-Proto hanya dibaca bila koneksi datang dari sini.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Database (dipakai juga oleh sqlx saat kompilasi; CI memakai metadata offline .sqlx/) ---
DATABASE_URL=postgres://eabsensi:eabsensi-lokal@127.0.0.1:5433/eabsensi_test
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT_SECS=5

# --- Aturan absensi (nama dan default sama dengan config/attendance.php Laravel) ---
ATTENDANCE_TIMEZONE=Asia/Jakarta
ATTENDANCE_MOBILE_REQUIRES_APPROVAL=true
ATTENDANCE_MOBILE_REQUIRES_PHOTO=true
ATTENDANCE_MOBILE_MIN_INTERVAL=60

# --- Token (format Sanctum; nilai harus sama dengan .env Laravel) ---
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=
# last_used_at diperbarui paling sering sekali per N detik per token (0 = setiap request, seperti Sanctum).
TOKEN_LAST_USED_DEBOUNCE_SECS=60

# --- Foto: harus folder yang sama dengan disk `local` Laravel (storage/app/private) ---
PHOTO_ROOT=../eabsensi-v2/storage/app/private
# Hak akses berkas/folder foto di Linux (oktal), agar PHP-FPM bisa membaca.
PHOTO_FILE_MODE=644
PHOTO_DIR_MODE=755

# --- Login: verifikasi bcrypt dibatasi agar lonjakan login tidak menghabiskan CPU ---
# Default: jumlah CPU. Login yang menunggu slot lebih lama dari LOGIN_HASH_QUEUE_SECS dibalas 429 + Retry-After.
# LOGIN_HASH_CONCURRENCY=8
LOGIN_HASH_QUEUE_SECS=5

# --- Batas laju (per menit; 0 = nonaktif). Default sama dengan AppServiceProvider Laravel ---
# Dua batas per IP berlaku untuk login. Di belakang NAT kantor (ribuan pegawai, satu IP) keduanya
# membatasi berapa pegawai bisa login per menit; naikkan atau 0-kan bila klien keluar lewat NAT bersama.
RATE_LIMIT_LOGIN_PER_IP=60
RATE_LIMIT_API_PER_IP=120
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_API_PER_TOKEN=120
RATE_LIMIT_ACTIONS_PER_USER=20
# memory (satu instance) atau redis (beberapa instance berbagi hitungan).
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://127.0.0.1:6379/0
